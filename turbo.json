{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "BCOS_API_BASE_URL",
        "BCOS_HOMOLOGATION_BEARER_TOKEN",
        "BCOS_HUMAN_TENANT_ID",
        "BCOS_IDENTITY_PROVIDER",
        "NEON_AUTH_BASE_URL",
        "NEON_AUTH_COOKIE_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    }
  }
}
